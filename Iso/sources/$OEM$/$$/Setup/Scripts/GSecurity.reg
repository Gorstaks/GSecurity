"DisabledByDefault"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\SSL 3.0\Server]
"Enabled"=dword:00000000
"DisabledByDefault"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\SSL 2.0\Client]
"Enabled"=dword:00000000
"DisabledByDefault"=dword:00000001

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\SecurityProviders\SCHANNEL\Protocols\SSL 2.0\Server]
"Enabled"=dword:00000000
"DisabledByDefault"=dword:00000001

; TLS cipher suite ordering (from Policies.reg - strong ciphers only)
[HKEY_LOCAL_MACHINE\SOFTWARE\policies\Microsoft\Cryptography\Configuration\SSL\00010002]
"EccCurves"=hex(7):6e,00,69,00,73,00,74,00,50,00,35,00,32,00,31,00,00,00,63,00,\
  75,00,72,00,76,00,65,00,32,00,35,00,35,00,31,00,39,00,00,00,4e,00,69,00,73,00,\
  74,00,50,00,33,00,38,00,34,00,00,00,4e,00,69,00,73,00,74,00,50,00,32,00,35,00,\
  36,00,00,00,00,00
"Functions"="TLS_CHACHA20_POLY1305_SHA256,TLS_AES_256_GCM_SHA384,TLS_AES_128_GCM_SHA256,TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256,TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384,TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256,TLS_DHE_RSA_WITH_AES_256_GCM_SHA384,TLS_DHE_RSA_WITH_AES_128_GCM_SHA256"

; .NET TLS system default
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\.NETFramework\v2.0.50727]
"SystemDefaultTlsVersions"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\.NETFramework\v2.0.50727]
"SystemDefaultTlsVersions"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\.NETFramework\v4.0.30319]
"SystemDefaultTlsVersions"=dword:00000001

[HKEY_LOCAL_MACHINE\SOFTWARE\WOW6432Node\Microsoft\.NETFramework\v4.0.30319]
"SystemDefaultTlsVersions"=dword:00000001


; -----------------------------------------------------------------------------
; SECTION 11 - WORM SURFACE REDUCTION / DCOM / RPC
; Source: Security.reg > Worms Doors Cleaner.reg
; (Sentinel: ReverseShell, DCOM lateral movement)
; -----------------------------------------------------------------------------

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Messenger]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NetBT]
"Start"=dword:00000004

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\NetBT\Parameters]
"SmbDeviceEnabled"=dword:00000000

; Disable DCOM (Sentinel: DCOM lateral movement detection)
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Ole]
"EnableDCOM"="N"
"UseInternetPorts"="N"
"LegacyAuthenticationLevel"=dword:00000005
"LegacyImpersonationLevel"=dword:00000003

[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Rpc\Internet]
"UseInternetPorts"="N"

; RPC restriction
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\Rpc]
"RestrictRemoteClients"=dword:00000001

; Disable NetBIOS / LLMNR (Sentinel: DNS tunnel / network recon)
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows NT\DNSClient]
"EnableNetbios"=dword:00000000

; Disable IPv6 (CVE-2024-38063)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Services\Tcpip6\Parameters]
"DisabledComponents"=dword:000000ff

; SMBv1 already set above in LanmanServer\Parameters

; Hardened UNC paths (Sentinel: lateral movement / PTH)
[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows\NetworkProvider\HardenedPaths]
"\\\\*\\NETLOGON"="RequireMutualAuthentication=1,RequireIntegrity=1"
"\\\\*\\SYSVOL"="RequireMutualAuthentication=1,RequireIntegrity=1"

; Crash dump disable (prevent memory dump of LSASS)
[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CrashControl]
"CrashDumpEnabled"=dword:00000000


; -----------------------------------------------------------------------------
; SECTION 12 - SRP / SAFER CODE IDENTIFIERS
; Source: Restrictions.reg
; (Sentinel: LOLBin execution, staging path execution, defense evasion)
; DefaultLevel=40000 = Disallowed, 262144 = Unrestricted
; Trusted paths (Windows, Program Files) are allow-listed explicitly.
; -----------------------------------------------------------------------------



