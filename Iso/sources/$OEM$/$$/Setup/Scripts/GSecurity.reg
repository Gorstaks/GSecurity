"PKInitHashAlgorithmConfigurationEnabled"=dword:00000001
"PKInitSHA1"=dword:00000000
"PKInitSHA256"=dword:00000003
"PKInitSHA384"=dword:00000003
"PKInitSHA512"=dword:00000003


